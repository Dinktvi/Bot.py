# Telegram bot token
BOT_TOKEN=8703346061:AAHK0-QBCy4UlAaGOtli7qpmHGVjC5pWKv4

# Global admin (owner)
ADMIN_ID=6382264272

# Extra admins, comma separated (optional)
# ADMIN_IDS=6382264272,111111111

# ---------- LLM for the AI assistant / support ----------
# REQUIRED for the AI to work. Use any OpenAI-compatible provider.
# Leave empty -> the assistant says "temporarily unavailable".

# Example 1: DeepSeek (cheap, ~0.2$/1M tokens)
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# Example 2: Groq (FREE tier available)
# USER_LLM_API_KEY=gsk_...
# USER_LLM_BASE_URL=https://api.groq.com/openai/v1
# USER_LLM_MODEL=llama-3.3-70b-versatile

# Example 3: Google Gemini (FREE tier via AI Studio, OpenAI-compatible endpoint)
# USER_LLM_API_KEY=AIza...
# USER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# USER_LLM_MODEL=gemini-2.0-flash

# ---------- AI model choice (per user) ----------
# Users can pick a model in the assistant menu.
# Default provider: groq (uses USER_LLM_* keys above) or deepseek.
# Set your DeepSeek key here to enable DeepSeek as a choice:
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEFAULT_AI_PROVIDER=groq

# SQLite database path
DB_PATH=data/bot.db
