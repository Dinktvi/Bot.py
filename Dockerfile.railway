FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY bot ./bot
COPY images.toml . 2>/dev/null || true
RUN mkdir -p assets data scripts

ENV PYTHONPATH=/app

# Railway expects the app to bind the port from $PORT.
# Our bot runs long-polling, but we expose a tiny HTTP keep-alive server
# on $PORT so Railway considers the service healthy.
EXPOSE 8080

CMD ["python3", "-m", "bot.main"]
